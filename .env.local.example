# ──────────────────────────────────────────────────────────────────────────
# NMK Global Jobs Portal — local environment template
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored; never commit real credentials.
# ──────────────────────────────────────────────────────────────────────────


# ─── API mode toggle ─────────────────────────────────────────────────────
# Controls how the frontend reaches the FastAPI backend.
#
#   proxy   (default) — Next.js Route Handler at /api/* forwards to FastAPI.
#                       FastAPI URL stays server-side.  Production setting.
#   direct           — Browser calls FastAPI directly using DIRECT_API_URL.
#                       FastAPI URL is visible in the browser bundle.
#                       Useful for debugging or when you want to bypass
#                       the Next.js proxy layer.
NEXT_PUBLIC_API_MODE=proxy


# ─── Server-only secrets ─────────────────────────────────────────────────
# Read by lib/server/config.js. NEVER prefixed with NEXT_PUBLIC_.
# These values stay on the Next.js server and never reach the browser.

# FastAPI backend URL used by the /api/* proxy handler.
API_BACKEND_URL=http://localhost:8000

# Reserved for future third-party credentials. Examples:
# STRIPE_SECRET_KEY=
# SENDGRID_API_KEY=
# JWT_SIGNING_KEY=


# ─── Public values (shipped to the browser bundle) ───────────────────────
# Only set this when API_MODE=direct. Ignored in proxy mode.
NEXT_PUBLIC_DIRECT_API_URL=http://localhost:8000
